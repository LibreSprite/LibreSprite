<gui>
  <window text="Script Permissions" id="script_permissions">
    <vbox>
      <box id="script_name_placeholder" /><!-- custom widget -->
      <label text="requests the following permissions:" />
      <check id="perm_fs_read" text="Read files (fs.read)" tooltip="fs.readFile, fs.stat, fs.listDir, fs.shareFile" />
      <check id="perm_fs_write" text="Write and delete files (fs.write)" tooltip="fs.writeFile, fs.copyFile, fs.deleteFile" />
      <check id="perm_fetch" text="Make network requests (fetch)" tooltip="fetch and storage.fetch" />
      <check id="perm_app_launch" text="Open files/URLs or launch processes with the OS (app.launch)" tooltip="app.launch" />
      <hbox>
        <boxfiller />
        <hbox homogeneous="true">
          <button text="&amp;OK" closewindow="true" id="ok" magnet="true" width="60" />
          <button text="&amp;Cancel" closewindow="true" id="cancel" />
        </hbox>
      </hbox>
    </vbox>
  </window>
</gui>
